// Cloudflare Worker — entrypoint unifié pour stayn-stains.fr
// Le worker reçoit toutes les requêtes : apex → www (301), /api/lead (proxy n8n),
// tout le reste est servi depuis dist/ via le binding ASSETS.
{
  "name": "stayn-stains-site",
  "main": "./src/worker.ts",
  "compatibility_date": "2025-01-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    // Exécute le worker AVANT de servir un asset statique existant.
    // Sinon /, /mentions-legales/… sont servis en direct sur l'apex et le
    // worker (redirection apex → www) n'est jamais appelé pour ces chemins.
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  },
  // Custom domains — préserve les bindings à chaque `wrangler deploy`
  // (sans ce bloc, un deploy détache www + apex du worker).
  "routes": [
    { "pattern": "www.stayn-stains.fr", "custom_domain": true },
    { "pattern": "stayn-stains.fr", "custom_domain": true }
  ],
  // Variables publiques injectées au runtime du worker.
  // - N8N_WEBHOOK_URL : URL du webhook n8n (payload non sensible).
  // - PUBLIC_GOOGLE_MAPS_KEY : clé Maps JS API restreinte par HTTP referrer
  //   (à brancher dans Google Cloud Console : whitelist `*.stayn-stains.fr`,
  //   `*.pages.dev`, `localhost:4321`). Exposée côté client via Astro.
  "vars": {
    "N8N_WEBHOOK_URL": "https://jmg958.app.n8n.cloud/webhook/stayn-stains-lead",
    "PUBLIC_GOOGLE_MAPS_KEY": ""
  }
}
