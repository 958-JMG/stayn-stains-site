---
import { type Locale, DEFAULT_LOCALE } from '../i18n/locales';
import { t } from '../i18n/strings';
interface Props { deadline: string; lang?: Locale; }
const { deadline, lang = DEFAULT_LOCALE } = Astro.props;
const s = t(lang);
const offerHref = lang === DEFAULT_LOCALE ? '/mentions-legales#offre' : `/${lang}/mentions-legales#offre`;
---
<section class="offer" id="offre" data-offer-section data-deadline={deadline} aria-label={s.offer.section_label}>
  <div class="container is-wide offer-grid">
    <div class="offer-main reveal">
      <span class="eyebrow">{s.offer.tag}</span>
      <h2><span class="offer-amount">{s.offer.amount}</span><br />{s.offer.per_room}</h2>
      <p class="offer-notary">{s.offer.notary}</p>
      <p class="lead">{s.offer.lead}</p>
      <p class="offer-limit">{s.offer.limit}</p>
      <p class="offer-deadline">{s.offer.deadline}</p>
      <p class="offer-fine">{s.offer.fine_prefix}<a href={offerHref}>{s.offer.fine_link}</a>{s.offer.fine_suffix}</p>
    </div>
    <aside class="offer-next reveal">
      <h3>{s.offer.steps_title}</h3>
      <ol><li>{s.offer.step1}</li><li>{s.offer.step2}</li><li>{s.offer.step3}</li></ol>
      <a href="#contact" class="btn btn--primary btn--lg" data-lead-cta="offer">{s.offer.cta} <span class="arrow" aria-hidden="true">→</span></a>
      <a href="tel:+33763277878" class="offer-phone"><bdi>07 63 27 78 78</bdi></a>
      <p class="offer-note">{s.offer.note}</p>
    </aside>
  </div>
  <p class="container offer-expired" data-offer-expired hidden>{s.offer.expired}</p>
</section>
<style>
  .offer { background: var(--bg-3); border-block: 1px solid var(--line); padding-block: var(--s-8); }
  .offer-grid { display:grid; gap:var(--s-6); align-items:center; }
  .eyebrow { color:var(--accent); margin-bottom:var(--s-3); }
  h2 { font-size:clamp(2.3rem,5vw,4rem); line-height:1.12; }
  .offer-amount { color:var(--accent); font-size:clamp(3.2rem,7vw,6rem); font-style:italic; }
  .offer-notary { color:var(--accent); font-family:var(--font-display); font-size:clamp(1.5rem,3vw,2.2rem); margin-block:var(--s-3); }
  .lead { margin-block:var(--s-4); }
  .offer-limit { display:inline-block; padding:.5rem .8rem; border:1px solid var(--accent); color:var(--accent); font-weight:650; }
  .offer-deadline { margin-top:var(--s-3); font-weight:600; }
  .offer-fine,.offer-note { font-size:var(--step--1); line-height:1.6; margin-top:var(--s-4); }
  .offer-fine a { text-decoration:underline; color:var(--accent); }
  .offer-next { background:var(--ink); padding:clamp(1.5rem,4vw,2.5rem); color:var(--cream); border-radius:6px; }
  .offer-next h3 { color:var(--cream); font-size:var(--step-4); }
  ol { padding-inline-start:1.3rem; margin-block:var(--s-5); display:grid; gap:var(--s-4); }
  li { padding-inline-start:.3rem; line-height:1.5; }
  .offer-next .btn { width:100%; text-align:center; white-space:normal; }
  .offer-phone { display:block; margin-top:var(--s-4); text-align:center; color:var(--cream); font-size:var(--step-2); }
  .offer-note { color:var(--cream); opacity:.8; text-align:center; }
  .offer-expired { margin-top:var(--s-4); font-weight:600; }
  [hidden] { display:none; }
  @media(min-width:960px) { .offer-grid { grid-template-columns:1.25fr 1fr; gap:var(--s-8); } }
</style>
<script>
  function checkOffer() {
    const section = document.querySelector<HTMLElement>('[data-offer-section]');
    if (section && Date.now() >= new Date(section.dataset.deadline || '').getTime()) {
      const message = section.querySelector<HTMLElement>('[data-offer-expired]');
      const details = section.querySelector<HTMLElement>('.offer-grid');
      if (message) {
        message.hidden = false;
        const heroLead = document.querySelector<HTMLElement>('.hero .lead');
        if (heroLead) heroLead.textContent = message.textContent;
      }
      document.querySelectorAll<HTMLElement>('.appart-offer').forEach((item) => { item.hidden = true; });
      if (details) details.hidden = true;
    }
  }
  checkOffer();
  document.addEventListener('astro:page-load', checkOffer);
</script>
